# Copy this file to .env and fill in what you have. Anything left blank keeps
# that channel in "simulated" mode: roster changes are logged (see Reports ->
# Shift Notification Report) but no real SMS/email is sent - safe for testing.

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Database (Turso - free, persistent, hosted SQLite) ----
# Leave both blank for local use: the app stores data in data/macelleria.db.
# That's fine on your own machine, but a FREE Render web service wipes its
# local disk on every restart/redeploy/sleep cycle - so for free hosting you
# need a Turso database instead. Sign up free at https://turso.tech (no card
# required), create a database from the dashboard (app.turso.tech), and copy
# its URL and an auth token in here (and into Render's environment variables).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Used only by `npm run seed` the FIRST time you set up the database.
SEED_OWNER_EMAIL=you@yourbusiness.com
SEED_OWNER_PASSWORD=ChangeMe123!

# ---- Email (SMTP) ----
# Works with Gmail (use an App Password), Outlook, or any SMTP provider
# (SendGrid, Postmark, Resend, Mailgun, etc. all offer an SMTP endpoint).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Macelleria Rostering <no-reply@yourbusiness.com>"

# ---- SMS (Twilio) ----
# Sign up at twilio.com, buy/verify a number, then fill these in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
